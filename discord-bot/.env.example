# ─── Discord ──────────────────────────────────────────────────────────────
# Token du bot (Discord Developer Portal → ton app → Bot → Reset Token)
DISCORD_TOKEN=
# Application/Client ID (Developer Portal → General Information → Application ID)
DISCORD_CLIENT_ID=
# ID du serveur (guild) où enregistrer les slash commands instantanément.
# Optionnel. Si vide, les commandes sont enregistrées globalement (peut prendre ~1h).
DISCORD_GUILD_ID=
# Channel ID pour les annonces YouTube (clic droit sur le salon → Copier l'ID en mode dev)
DISCORD_CHANNEL_YOUTUBE=
# Channel ID pour les annonces de sorties de slots
DISCORD_CHANNEL_SLOTS=1527979665216507904
# Channel ID pour les annonces Rumble (🟧 · rumble)
DISCORD_CHANNEL_RUMBLE=
# Channel ID pour les annonces LIVE Rumble (🔴 en direct)
DISCORD_CHANNEL_RUMBLE_LIVE=
# Channel ID pour les pronos (verrouillé pour les non-admins pendant un match)
DISCORD_CHANNEL_PRONOS=
# Channel ID pour les calls machines (verrouillé pour les non-admins pendant une session)
DISCORD_CHANNEL_CALLS=1527322822207082558

# ─── Supabase ─────────────────────────────────────────────────────────────
# URL projet (Supabase → Project Settings → API → Project URL)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key (Supabase → Project Settings → API → service_role).
# IMPORTANT : ne jamais exposer côté front/site ; dispo uniquement côté bot.
SUPABASE_SERVICE_ROLE_KEY=

# ─── YouTube ──────────────────────────────────────────────────────────────
# Chaîne surveillée (RSS public, pas de clé API)
# Handle @19enpleinn → https://www.youtube.com/@19enpleinn
YOUTUBE_CHANNEL_HANDLE=19enpleinn
# Optionnel si tu connais déjà l'ID (sinon résolu auto depuis le handle)
YOUTUBE_CHANNEL_ID=UC33jMbT4OaTdnb1oC6XVYgA
YOUTUBE_CHANNEL_LABEL=19enplein

# ─── Rumble ───────────────────────────────────────────────────────────────
# https://rumble.com/user/19enplein
RUMBLE_USER_SLUG=19enplein
RUMBLE_CHANNEL_URL=https://rumble.com/user/19enplein
RUMBLE_CHANNEL_LABEL=19enplein
# Optionnel — API live officielle (https://rumble.com/account/livestream-api) → détection plus fiable
RUMBLE_LIVE_API_URL=

# ─── BigWinBoard (sorties de slots) ───────────────────────────────────────
# URL du flux RSS BigWinBoard (par défaut, le feed "reviews" qui couvre toutes les sorties)
BIGWINBOARD_RSS=https://bigwinboard.com/feed/

# ─── Tâches planifiées ────────────────────────────────────────────────────
# Expression cron pour le check YouTube (par défaut toutes les 10 min)
CRON_YOUTUBE=*/10 * * * *
# Expression cron pour le check Rumble (par défaut toutes les 10 min)
CRON_RUMBLE=*/10 * * * *
# Check live Rumble (par défaut toutes les 3 min)
CRON_RUMBLE_LIVE=*/3 * * * *
# Expression cron pour le check BigWinBoard (par défaut toutes les 30 min)
CRON_SLOTS=*/30 * * * *
# Sync paris sportifs (matchs + cotes PropLine) — 5 min, sports actifs en base
CRON_SPORTS_ODDS=*/5 * * * *
# Scores PropLine hors-foot (cron secours 1 min + boucle 45 s si live)
CRON_SPORTS_SCORES=*/1 * * * *
# Règlement automatique des paris — 5 min par défaut
CRON_SPORTS_SETTLE=*/5 * * * *

# ─── PropLine (cotes sportives) ───────────────────────────────────────────
# Clé API PropLine (plan Hobby 9$/mois) — https://prop-line.com/pricing
PROPLINE_API_KEY=
# Sports synchronisés : `all` = tous les sports actifs PropLine (~46). Ou CSV : soccer_epl,tennis,...
PROPLINE_SPORTS=all
# Cache liste /sports (ms) — 1 h par défaut
PROPLINE_SPORTS_CACHE_MS=3600000
# Pause entre chaque sport lors du sync (ms)
PROPLINE_SYNC_DELAY_MS=120
# Marchés fetchés par event
PROPLINE_MARKETS=h2h,totals,spreads,correct_score,both_teams_to_score,double_chance
# Fenêtre d'anticipation (heures) — matchs commençant dans les X h
PROPLINE_HOURS_AHEAD=168
# Bookmaker prioritaire affiché sur le site (les autres restent en base)
PROPLINE_PRIMARY_BOOKMAKER=pinnacle
# Cotes : active = sports avec matchs en base seulement (~50 % quota). all = tous les sports PropLine.
PROPLINE_ODDS_SCOPE=active
# Budget quota journalier (marge sous 25 000 Pro) + réserve avant pause auto
PROPLINE_DAILY_BUDGET=24000
PROPLINE_QUOTA_RESERVE=800
# Scores PropLine hors-foot : intervalle boucle rapide (ms) — 0 req si aucun live
PROPLINE_SCORES_INTERVAL_MS=45000
# Scores foot ESPN (gratuit) : intervalle boucle (ms)
ESPN_SCORES_INTERVAL_MS=30000
# Cron pour les nouvelles slots via SlotCatalog (toutes les 30 min par défaut)
# — couvre le même périmètre de jeux neufs que Stake / Gamdom / Shuffle / Celsius (source unique, plus fiable)
CRON_CASINO=*/30 * * * *
# Sources casino (CSV). slotreport = API fiable ; stake/gamdom/… souvent 403 (Cloudflare/ANJ)
CASINO_SOURCES=slotcatalog,slotreport,stake,gamdom,shuffle,celsius
# Secret pour déclencher POST /internal/casino-pass?secret=…
INTERNAL_JOB_SECRET=
# Délai (ms) avant de lancer le premier check après démarrage
INITIAL_DELAY_MS=8000

# ─── Site HugoTaSlot ──────────────────────────────────────────────────────
SITE_URL=https://hugotaslot.fr

# ─── Rich Presence (statut affiché sous le nom du bot) ───────────────────
# Mode static par défaut — équivalent UpdatePresence() RPC :
#   details=Competitive, state=Playing Solo, images, party, join secret
PRESENCE_MODE=static
PRESENCE_STATUS=online
PRESENCE_TYPE=playing
PRESENCE_DETAILS=19ENPLEIN CASINO
PRESENCE_STATE=Gamdom · hugotaslot.fr
PRESENCE_START_TS=0
PRESENCE_END_TS=0
PRESENCE_LARGE_IMAGE_KEY=image_19
PRESENCE_LARGE_IMAGE_TEXT=19ENPLEIN CASINO
PRESENCE_SMALL_IMAGE_KEY=gamdom
PRESENCE_SMALL_IMAGE_TEXT=Gamdom
PRESENCE_PARTY_ID=ae488379-351d-4a4f-ad32-2b9b01c91657
PRESENCE_PARTY_SIZE=1
PRESENCE_PARTY_MAX=5
PRESENCE_JOIN_SECRET=MTI4NzM0OjFpMmhuZToxMjMxMjM=
# Fichiers : discord-bot/assets/rich-presence/ → upload Developer Portal (Rich Presence → Art Assets)
# PRESENCE_MODE=off | rotate
# PRESENCE_ROTATION_JSON=[{"type":"watching","name":"hugotaslot.fr"}]

# ─── Logs ─────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info
