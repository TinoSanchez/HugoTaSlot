# ─── Discord ──────────────────────────────────────────────────────────────
# Token du bot (Discord Developer Portal → ton app → Bot → Reset Token)
DISCORD_TOKEN=
# Application/Client ID (Developer Portal → General Information → Application ID)
DISCORD_CLIENT_ID=
# ID du serveur (guild) où enregistrer les slash commands instantanément.
# Optionnel. Si vide, les commandes sont enregistrées globalement (peut prendre ~1h).
DISCORD_GUILD_ID=
# Channel ID pour les annonces YouTube (clic droit sur le salon → Copier l'ID en mode dev)
DISCORD_CHANNEL_YOUTUBE=
# Channel ID pour les annonces de sorties de slots
DISCORD_CHANNEL_SLOTS=

# ─── Supabase ─────────────────────────────────────────────────────────────
# URL projet (Supabase → Project Settings → API → Project URL)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key (Supabase → Project Settings → API → service_role).
# IMPORTANT : ne jamais exposer côté front/site ; dispo uniquement côté bot.
SUPABASE_SERVICE_ROLE_KEY=

# ─── YouTube ──────────────────────────────────────────────────────────────
# Chaîne surveillée (RSS public, pas de clé API)
# Handle @19enpleinn → https://www.youtube.com/@19enpleinn
YOUTUBE_CHANNEL_HANDLE=19enpleinn
# Optionnel si tu connais déjà l'ID (sinon résolu auto depuis le handle)
YOUTUBE_CHANNEL_ID=UC33jMbT4OaTdnb1oC6XVYgA
YOUTUBE_CHANNEL_LABEL=19enplein

# ─── BigWinBoard (sorties de slots) ───────────────────────────────────────
# URL du flux RSS BigWinBoard (par défaut, le feed "reviews" qui couvre toutes les sorties)
BIGWINBOARD_RSS=https://bigwinboard.com/feed/

# ─── Tâches planifiées ────────────────────────────────────────────────────
# Expression cron pour le check YouTube (par défaut toutes les 10 min)
CRON_YOUTUBE=*/10 * * * *
# Expression cron pour le check BigWinBoard (par défaut toutes les 30 min)
CRON_SLOTS=*/30 * * * *
# Cron pour les nouvelles slots via SlotCatalog (toutes les 30 min par défaut)
# — couvre le même périmètre de jeux neufs que Stake / Gamdom / Shuffle / Celsius (source unique, plus fiable)
CRON_CASINO=*/30 * * * *
# Source(s) : par défaut « slotcatalog » seul. Autres (stake, gamdom, shuffle, celsius) = expérimental
CASINO_SOURCES=slotcatalog
# Délai (ms) avant de lancer le premier check après démarrage
INITIAL_DELAY_MS=8000

# ─── Site HugoTaSlot ──────────────────────────────────────────────────────
SITE_URL=https://hugotaslot.fr

# ─── Rich Presence (statut affiché sous le nom du bot) ───────────────────
# Mode static par défaut — équivalent UpdatePresence() RPC :
#   details=Competitive, state=Playing Solo, images, party, join secret
PRESENCE_MODE=static
PRESENCE_STATUS=online
PRESENCE_TYPE=playing
PRESENCE_DETAILS=19ENPLEIN CASINO
PRESENCE_STATE=Gamdom · hugotaslot.fr
PRESENCE_START_TS=0
PRESENCE_END_TS=0
PRESENCE_LARGE_IMAGE_KEY=image_19
PRESENCE_LARGE_IMAGE_TEXT=19ENPLEIN CASINO
PRESENCE_SMALL_IMAGE_KEY=gamdom
PRESENCE_SMALL_IMAGE_TEXT=Gamdom
PRESENCE_PARTY_ID=ae488379-351d-4a4f-ad32-2b9b01c91657
PRESENCE_PARTY_SIZE=1
PRESENCE_PARTY_MAX=5
PRESENCE_JOIN_SECRET=MTI4NzM0OjFpMmhuZToxMjMxMjM=
# Fichiers : discord-bot/assets/rich-presence/ → upload Developer Portal (Rich Presence → Art Assets)
# PRESENCE_MODE=off | rotate
# PRESENCE_ROTATION_JSON=[{"type":"watching","name":"hugotaslot.fr"}]

# ─── Logs ─────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info
