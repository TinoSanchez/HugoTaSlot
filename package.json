{
  "name": "site-bh-1.02",
  "version": "1.0.5",
  "description": "HugoTaSlot Bonus Hunt — site prod à la racine (index.html, styles.css, app.js) ; web/ = prototype Vite hors prod.",
  "scripts": {
    "start": "node serve.js",
    "test": "node --test scripts/catalog-smoke.test.mjs scripts/stake-match.test.mjs scripts/cloud-core.test.mjs",
    "test:e2e": "node scripts/build-boot-bundle.mjs && node scripts/e2e/run-e2e.mjs",
    "test:e2e:prod": "node scripts/e2e/run-e2e-remote.mjs",
    "build:boot": "node scripts/build-boot-bundle.mjs",
    "verify:supabase": "node scripts/verify-supabase-migrations.mjs",
    "dev": "vite web",
    "dev:site": "node serve.js",
    "build": "node scripts/build-original-site.mjs",
    "split:index": "node scripts/split-index-html.mjs",
    "preview": "vite preview web",
    "deploy:vercel": "npm run build && vercel deploy --prod --yes --archive=tgz",
    "sync:stake": "node scripts/sync-stake-catalog.mjs",
    "sync:recent-slots": "node scripts/sync-recent-slots-to-jeux.mjs",
    "sync:jeux-full": "node scripts/sync-recent-slots-to-jeux.mjs && node scripts/sync-stake-catalog.mjs",
    "enrich:images": "node scripts/enrich-jeux-images.mjs",
    "enrich:gamdom-api": "node scripts/enrich-gamdom-api-placeholders.mjs",
    "enrich:stake-placeholders": "node scripts/enrich-stake-placeholders.mjs",
    "enrich:images:full": "node scripts/enrich-jeux-images.mjs && node scripts/enrich-gamdom-api-placeholders.mjs",
    "enrich:ci": "node scripts/enrich-jeux-images.mjs && node scripts/ci-catalog-stats.mjs --markdown",
    "catalog:stats": "node scripts/ci-catalog-stats.mjs",
    "catalog:strip-placeholders": "node scripts/strip-catalog-placeholders.mjs",
    "catalog:prune-orphans": "node scripts/prune-orphan-placeholders.mjs",
    "vercel:login": "vercel login",
    "supabase:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > web/src/lib/database.types.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@supabase/supabase-js": "^2.50.0",
    "playwright": "^1.59.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "vercel": "^50.41.0",
    "vite": "^7.1.0"
  }
}
